OVERRIDE_HOSTNAME=mail.niksusername.com
DOMAINNAME=niksusername.com

ENABLE_CLAMAV=1
ENABLE_SPAMASSASSIN=1
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
ENABLE_MANAGESIEVE=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1

SSL_TYPE=manual
SSL_CERT_PATH=/etc/letsencrypt/live/mail.niksusername.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mail.niksusername.com/key.pem
